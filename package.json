{
  "name": "gym-recepcion",
  "version": "1.0.0",
  "description": "Recepción del gimnasio: control de entradas, mensualidades, pases diarios y reportes.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js data/demo.db && node --disable-warning=ExperimentalWarning server.js --db data/demo.db",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "build:demo": "node scripts/build-demo.js",
    "demo:web": "node scripts/build-demo.js --serve"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2"
  }
}
